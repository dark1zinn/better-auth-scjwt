{
  "name": "better-auth-scjwt",
  "version": "0.1.0",
  "description": "An plugin for better-auth to implement Session-Centric JWT (CSJWT)",
  "keywords": [
    "better-auth",
    "plugin",
    "session-centric-jwt",
    "csjwt"
  ],
  "type": "module",
  "workspaces": [
    "examples/*"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./client": {
      "types": "./dist/client.d.mts",
      "import": "./dist/client.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "bun test test",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test:package": "bun scripts/check-package.ts",
    "prepack": "bun run build"
  },
  "author": "dark1zinn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dark1zinn/better-auth-scjwt.git"
  },
  "bugs": {
    "url": "https://github.com/dark1zinn/better-auth-scjwt/issues"
  },
  "homepage": "https://github.com/dark1zinn/better-auth-scjwt#readme",
  "license": "MIT",
  "peerDependencies": {
    "@better-auth/core": "~1.7.18",
    "better-auth": "~1.7.18",
    "jose": "^6.2.12"
  },
  "dependencies": {
    "better-call": "1.4.5"
  },
  "devDependencies": {
    "@better-auth/core": "1.7.18",
    "@types/bun": "^1.4.2",
    "better-auth": "1.7.18",
    "jose": "^6.2.12",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  }
}
